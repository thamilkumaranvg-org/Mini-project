# ======================================================================
# Farmer Slot Booking System: Environment Configuration Template
# DO NOT PUT REAL SECRETS IN THIS FILE (.env.example is committed to git)
# Copy this file to .env and put your real secrets there.
# ======================================================================

# Application Environment (development | production)
APP_ENV=development
APP_BASE_URL=http://localhost:8000

# Supabase Credentials (obtain from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder

# Cookie Security (set to true in production with HTTPS)
COOKIE_SECURE=false

# Timezone & Booking Business Rules
TIMEZONE=Asia/Kolkata
BOOKING_WINDOW_DAYS=7
ALMOST_FULL_THRESHOLD=2
BOOKING_CLOSE_MINUTES_BEFORE_END=0
CHECKIN_OPEN_MINUTES_BEFORE=0
MAX_QUANTITY_KG=10000

# Development-Only Time Override (ISO 8601 format, e.g. 2026-11-09T09:30:00+05:30)
# Ignored completely when APP_ENV=production
TIME_OVERRIDE_ISO=

# Email Configuration (console | resend | smtp)
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@farmerslotbooking.gov.in

# Resend API Key (required if EMAIL_PROVIDER=resend)
RESEND_API_KEY=your_resend_api_key_here

# SMTP Settings (required if EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Initial Bootstrap Administrator Credentials (used by scripts/create_admin.py)
ADMIN_EMAIL=admin@slotbooking.gov.in
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_FULL_NAME="Super Administrator"

# Rate Limiting
LOGIN_RATE_LIMIT=10/minute
